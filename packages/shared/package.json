{
  "name": "@novu/shared",
  "version": "2.6.6",
  "description": "",
  "scripts": {
    "start": "node init && npm run start:dev",
    "afterinstall": "pnpm build",
    "prebuild": "rimraf dist",
    "build": "node init && npm run build:cjs && npm run build:esm",
    "build:esm": "node init && tsc -p tsconfig.esm.json",
    "build:cjs": "node init && tsc -p tsconfig.json",
    "build:watch": "node init && cross-env node_modules/.bin/tsc -p tsconfig.json -w --preserveWatchOutput",
    "postbuild": "npm run check:circulars",
    "start:dev": "node init && pnpm build:watch",
    "precommit": "lint-staged",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "watch:test": "pnpm test --watch",
    "check:circulars": "madge --circular --extensions ts ./src"
  },
  "author": "",
  "license": "ISC",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist/",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.js"
    },
    "./utils": {
      "require": "./dist/cjs/utils/index.js",
      "import": "./dist/esm/utils/index.js",
      "types": "./dist/esm/utils/index.d.js"
    }
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "rimraf": "^3.0.2",
    "typescript": "5.6.2",
    "vitest": "^2.1.9"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}
